---
/**
 * AR monogram — the A's right leg is also the R's stem (a shared vertical),
 * so the two letters read as one geometric ligature.
 * Same geometry as public/brand/ar-monogram.svg.
 */
interface Props { size?: number; title?: string; class?: string }
const { size = 36, title, class: cls } = Astro.props;
---
<svg
  class={cls}
  width={size}
  height={size}
  viewBox="0 0 64 64"
  fill="none"
  role={title ? 'img' : undefined}
  aria-hidden={title ? undefined : 'true'}
  aria-label={title}
>
  <g stroke="currentColor" stroke-width="3.5" stroke-linecap="square" stroke-linejoin="miter">
    <path d="M8 56 L31 8 L31 56" />
    <path d="M18.5 37 H31" />
    <path d="M31 8 H41 A11 11 0 0 1 41 30 H31" />
    <path d="M40 30 L56 56" />
  </g>
  <circle cx="56" cy="8" r="2.6" fill="#8298B5" />
</svg>
