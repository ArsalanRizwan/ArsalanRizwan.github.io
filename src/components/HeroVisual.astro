---
/**
 * Original hero visual: a slowly rotating point-cloud sphere wrapped by an orbit,
 * drawn on <canvas>. Static frame when the user prefers reduced motion.
 */
---
<div class="hero-visual" aria-hidden="true">
  <canvas data-hero-canvas></canvas>
  <div class="hv-ring"></div>
  <div class="hv-coords label">
    <span>31.47° N</span><span>74.40° E</span>
  </div>
</div>

<style>
  .hero-visual { position: relative; width: 100%; aspect-ratio: 1; max-width: 720px; margin-inline: auto; }
  canvas { width: 100%; height: 100%; }
  .hv-ring {
    position: absolute; inset: 6%; border-radius: 50%;
    border: 1px solid var(--line);
  }
  .hv-ring::after {
    content: ''; position: absolute; inset: 14%; border-radius: 50%; border: 1px dashed rgba(130, 152, 181, 0.22);
  }
  .hv-coords { position: absolute; right: 0; bottom: 4%; display: grid; gap: 0.2rem; text-align: right; color: var(--subtle); font-size: 0.65rem; }
</style>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('[data-hero-canvas]');
  if (canvas) {
    const ctx = canvas.getContext('2d')!;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const N = 900;
    const pts: [number, number, number][] = [];
    // Fibonacci sphere with a soft "terrain" displacement
    for (let i = 0; i < N; i++) {
      const y = 1 - (i / (N - 1)) * 2;
      const r = Math.sqrt(1 - y * y);
      const t = i * Math.PI * (3 - Math.sqrt(5));
      const n = 1 + 0.06 * Math.sin(5 * y + 3 * Math.cos(t * 0.5));
      pts.push([Math.cos(t) * r * n, y * n, Math.sin(t) * r * n]);
    }
    let w = 0, h = 0, dpr = 1, raf = 0, angle = 0.6, mx = 0, my = 0, visible = true;
    const resize = () => {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = canvas.clientWidth; h = canvas.clientHeight;
      canvas.width = w * dpr; canvas.height = h * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      draw();
    };
    const draw = () => {
      ctx.clearRect(0, 0, w, h);
      const R = Math.min(w, h) * 0.34;
      const cx = w / 2, cy = h / 2;
      const ay = angle + mx * 0.3, ax = -0.35 + my * 0.2;
      const cosY = Math.cos(ay), sinY = Math.sin(ay), cosX = Math.cos(ax), sinX = Math.sin(ax);
      for (const [x0, y0, z0] of pts) {
        const x1 = x0 * cosY - z0 * sinY;
        const z1 = x0 * sinY + z0 * cosY;
        const y1 = y0 * cosX - z1 * sinX;
        const z2 = y0 * sinX + z1 * cosX;
        const depth = (z2 + 1.1) / 2.2; // 0 back .. 1 front
        const px = cx + x1 * R, py = cy + y1 * R;
        const a = 0.12 + depth * 0.78;
        const s = 0.6 + depth * 1.3;
        ctx.fillStyle = depth > 0.72 ? `rgba(241,240,236,${a})` : `rgba(130,152,181,${a})`;
        ctx.fillRect(px - s / 2, py - s / 2, s, s);
      }
      // orbit
      ctx.strokeStyle = 'rgba(130,152,181,0.45)';
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.ellipse(cx, cy, R * 1.42, R * 0.36, -0.42 + mx * 0.05, 0, Math.PI * 2);
      ctx.stroke();
      const oa = angle * 1.6;
      const ox = cx + Math.cos(oa) * R * 1.42, oy = cy + Math.sin(oa) * R * 0.36;
      const rx = (ox - cx) * Math.cos(-0.42) - (oy - cy) * Math.sin(-0.42) + cx;
      const ry = (ox - cx) * Math.sin(-0.42) + (oy - cy) * Math.cos(-0.42) + cy;
      ctx.fillStyle = '#f1f0ec';
      ctx.beginPath(); ctx.arc(rx, ry, 3, 0, Math.PI * 2); ctx.fill();
    };
    const loop = () => {
      angle += 0.0018;
      draw();
      raf = visible ? requestAnimationFrame(loop) : 0;
    };
    resize();
    window.addEventListener('resize', resize);
    if (!reduce) {
      new IntersectionObserver(([e]) => {
        visible = e.isIntersecting;
        if (visible && !raf) raf = requestAnimationFrame(loop);
      }).observe(canvas);
      window.addEventListener('pointermove', (e) => {
        mx = (e.clientX / window.innerWidth - 0.5) * 2;
        my = (e.clientY / window.innerHeight - 0.5) * 2;
      }, { passive: true });
    }
  }
</script>
