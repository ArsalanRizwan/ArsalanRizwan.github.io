---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import ProjectVisual from '../../components/ProjectVisual.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projects, sortedProjects } from '../../data/projects';
import { categories, type Project } from '../../data/types';

export function getStaticPaths() {
  return projects.filter((p) => !p.customPage).map((p) => ({ params: { slug: p.slug }, props: { project: p } }));
}

const { project } = Astro.props as { project: Project };
const cat = categories.find((c) => c.id === project.category)!;
const extra = (project.alsoIn ?? []).map((id) => categories.find((c) => c.id === id)!.label);
const idx = sortedProjects.findIndex((p) => p.id === project.id);
const next = sortedProjects[(idx + 1) % sortedProjects.length];
const related = sortedProjects
  .filter((p) => p.id !== project.id && p.id !== next.id && (p.category === project.category || p.alsoIn?.includes(project.category)))
  .slice(0, 2);
const ogImage = project.cover ? project.cover.src.src : undefined;
const iconLike = project.cover && project.cover.src.width === project.cover.src.height;
---
<Base
  title={project.title}
  description={project.shortDescription}
  image={ogImage}
  imageAlt={project.cover?.alt}
  type="article"
  jsonLd={[{
    '@context': 'https://schema.org',
    '@type': 'CreativeWork',
    name: project.title,
    description: project.shortDescription,
    genre: cat.label,
    keywords: project.technologies.join(', '),
    creator: { '@type': 'Person', name: 'Arsalan Rizwan' },
  }]}
>
  <article>
    <header class="p-hero container">
      <nav class="label crumbs" aria-label="Breadcrumb"><a href="/work/">Work</a> <span aria-hidden="true">/</span> <a href={`/work/?category=${cat.id}`}>{cat.label}</a></nav>
      <div class="p-hero-grid">
        <h1><span class="split-line" data-reveal><span>{project.title}</span></span></h1>
        <div class="p-hero-side" data-reveal style="--delay:.1s">
          <p class="lead">{project.shortDescription}</p>
          <span class={`status ${project.status === 'Published' ? 'status--available' : project.status === 'In development' ? 'status--soon' : 'status--muted'}`}>{project.status}</span>
        </div>
      </div>
    </header>

    <div class="container" data-reveal>
      <ProjectVisual project={project} eager sizes="100vw" ratio={iconLike ? '21 / 9' : '16 / 9'} fit={iconLike ? 'contain' : 'cover'} />
    </div>

    <div class="container body">
      <aside class="meta">
        <dl>
          <div><dt class="label">Category</dt><dd>{cat.label}{extra.length > 0 && <span class="muted"><br />{extra.join(' · ')}</span>}</dd></div>
          {project.role && <div><dt class="label">My role</dt><dd>{project.role}</dd></div>}
          {project.platforms && <div><dt class="label">Platforms</dt><dd>{project.platforms.join(' · ')}</dd></div>}
          {project.year && <div><dt class="label">Year</dt><dd>{project.year}</dd></div>}
          {project.technologies.length > 0 && <div><dt class="label">Technologies</dt><dd><ul class="chips">{project.technologies.map((t) => <li class="chip">{t}</li>)}</ul></dd></div>}
          {project.links && project.links.length > 0 && (
            <div><dt class="label">Links</dt><dd class="links">{project.links.map((l) => <a class="link" href={l.href} target="_blank" rel="noopener">{l.label} ↗<span class="sr-only"> (opens in a new tab)</span></a>)}</dd></div>
          )}
          <div><dt class="label">Sources</dt><dd class="muted small">{project.sources.map((s, i) => <>{i > 0 && ' · '}{s.href ? <a href={s.href} target="_blank" rel="noopener" class="u">{s.label}</a> : s.label}</>)}</dd></div>
        </dl>
      </aside>

      <div class="content">
        <section aria-labelledby="ov-h">
          <h2 id="ov-h" class="label label--accent">Overview</h2>
          {project.description.map((p, i) => <p class={i === 0 ? 'first' : ''} data-reveal>{p}</p>)}
        </section>

        {project.features && project.features.length > 0 && (
          <section aria-labelledby="ft-h">
            <h2 id="ft-h" class="label label--accent">Main features</h2>
            <ul class="features">{project.features.map((f, i) => <li data-reveal><span class="index-num">{String(i + 1).padStart(2, '0')}</span>{f}</li>)}</ul>
          </section>
        )}

        {project.challenges && project.challenges.length > 0 && (
          <section aria-labelledby="ch-h">
            <h2 id="ch-h" class="label label--accent">Development challenges</h2>
            {project.challenges.map((c) => <div class="cs"><h3>{c.title}</h3><p class="muted">{c.body}</p></div>)}
          </section>
        )}

        {project.implementation && project.implementation.length > 0 && (
          <section aria-labelledby="im-h">
            <h2 id="im-h" class="label label--accent">Implementation</h2>
            {project.implementation.map((c) => <div class="cs"><h3>{c.title}</h3><p class="muted">{c.body}</p></div>)}
          </section>
        )}

        {project.outcomes && project.outcomes.length > 0 && (
          <section aria-labelledby="oc-h">
            <h2 id="oc-h" class="label label--accent">Outcomes</h2>
            <ul class="features">{project.outcomes.map((o) => <li>{o}</li>)}</ul>
          </section>
        )}

        {project.videos && project.videos.length > 0 && (
          <section aria-labelledby="vd-h">
            <h2 id="vd-h" class="label label--accent">Video</h2>
            <ul class="features">{project.videos.map((v) => <li><a class="link" href={v.url} target="_blank" rel="noopener">{v.title} ↗</a></li>)}</ul>
          </section>
        )}

        {project.needsAssets && (
          <p class="note">Visuals for this project are being prepared. Screenshots and video will be added here.</p>
        )}
      </div>
    </div>

    {project.images && project.images.length > 0 && (
      <section class="container gallery" aria-label="Project gallery">
        {project.images.map((img, i) => (
          <figure class={`g-item g-item--${i % 3}`} data-reveal>
            <div class="media">
              <Image src={img.src} alt={img.alt} widths={[600, 1000, 1600]} sizes="(max-width: 800px) 100vw, 50vw" />
            </div>
            {img.caption && <figcaption class="label">{img.caption}</figcaption>}
          </figure>
        ))}
      </section>
    )}

    <section class="container more" aria-labelledby="more-h">
      <div class="next" data-reveal>
        <p class="label">Next project</p>
        <a href={next.customPage ?? `/work/${next.slug}/`} class="next-link">{next.title} <span aria-hidden="true">→</span></a>
      </div>
      {related.length > 0 && (
        <>
          <h2 id="more-h" class="label label--accent rel-h">Related in {cat.label}</h2>
          <div class="rel">{related.map((p) => <ProjectCard project={p} />)}</div>
        </>
      )}
    </section>
  </article>
</Base>

<style>
  .p-hero { padding-top: calc(var(--header-h) + clamp(3rem, 7vw, 7rem)); padding-bottom: clamp(2rem, 4vw, 4rem); }
  .crumbs { display: flex; gap: 0.6rem; flex-wrap: wrap; margin-bottom: 2.5rem; }
  .crumbs a { color: var(--subtle); } .crumbs a:hover { color: var(--ivory); }
  .p-hero-grid { display: grid; grid-template-columns: 1.4fr 1fr; gap: 2rem 4rem; align-items: end; }
  .p-hero h1 { font-size: clamp(2.6rem, 1.4rem + 4.6vw, 6.4rem); letter-spacing: -0.045em; }
  .p-hero-side { display: grid; gap: 1.5rem; justify-items: start; }
  .p-hero-side .lead { margin: 0; }
  .body { display: grid; grid-template-columns: 1fr 2fr; gap: clamp(2rem, 6vw, 7rem); padding-block: clamp(3rem, 7vw, 7rem); }
  .meta dl { margin: 0; display: grid; gap: 1.6rem; position: sticky; top: calc(var(--header-h) + 2rem); }
  .meta dd { margin: 0.5rem 0 0; }
  .meta .chips { margin-top: 0.3rem; }
  .links { display: grid; justify-items: start; gap: 0.3rem; }
  .small { font-size: var(--fs-small); } .u { text-decoration: underline; text-underline-offset: 3px; }
  .content section + section { margin-top: clamp(3rem, 5vw, 4.5rem); }
  .content h2 { margin-bottom: 1.5rem; }
  .content p { color: var(--muted); font-size: 1.08rem; max-width: 62ch; }
  .content p.first { font-size: var(--fs-lead); color: var(--ivory); line-height: 1.5; }
  .features { list-style: none; border-top: 1px solid var(--line); }
  .features li { display: flex; gap: 1.25rem; padding: 1rem 0; border-bottom: 1px solid var(--line); }
  .cs { padding: 1.25rem 0; border-top: 1px solid var(--line); }
  .cs h3 { font-size: 1.2rem; margin-bottom: 0.5rem; }
  .content .note { margin-top: 3rem; }
  .gallery { display: grid; grid-template-columns: repeat(2, 1fr); gap: clamp(1rem, 2.5vw, 2.5rem); padding-bottom: var(--section); }
  .g-item { margin: 0; }
  .g-item--0 { grid-column: 1 / -1; }
  .g-item .media :global(img) { width: 100%; height: auto; }
  .g-item figcaption { margin-top: 0.8rem; }
  .more { border-top: 1px solid var(--line); padding-block: clamp(3rem, 7vw, 7rem); }
  .next-link { display: inline-flex; gap: 1rem; font-size: clamp(2rem, 1.3rem + 3vw, 4.5rem); letter-spacing: -0.04em; margin-top: 0.75rem; transition: color 0.4s; }
  .next-link:hover { color: var(--slate); }
  .rel-h { margin: clamp(3rem, 6vw, 6rem) 0 2rem; }
  .rel { display: grid; grid-template-columns: repeat(2, 1fr); gap: 2.5rem; }
  @media (max-width: 900px) {
    .p-hero-grid, .body, .rel { grid-template-columns: 1fr; }
    .meta dl { position: static; grid-template-columns: 1fr 1fr; }
    .gallery { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) { .meta dl { grid-template-columns: 1fr; } }
</style>
