---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" noindex>
  <section class="container nf">
    <p class="label label--accent">Error 404</p>
    <h1>Lost in <span class="serif-i">the weather.</span></h1>
    <p class="lead">The page you were looking for doesn’t exist or has moved.</p>
    <div class="ctas"><a class="btn btn--primary" href="/">Back home</a><a class="btn btn--ghost" href="/work/">See the work</a></div>
  </section>
</Base>
<style>
  .nf { min-height: 80vh; padding-top: calc(var(--header-h) + 8rem); padding-bottom: 6rem; }
  h1 { margin: 1.5rem 0; }
  .ctas { display: flex; gap: 1rem; flex-wrap: wrap; margin-top: 2.5rem; }
</style>
